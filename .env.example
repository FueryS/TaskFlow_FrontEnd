# API Base URL (Point to local backend or production Render URL: https://taskflow-backend-kazo.onrender.com/api/v1)
VITE_API_BASE_URL=https://taskflow-backend-kazo.onrender.com/api/v1

# Client Handshake Signature (Required for security verification)
VITE_CLIENT_SECRET_TOKEN=taskflow-web-client-v1

# Heartbeat Ping Interval in Milliseconds (Default: 45000ms = 45 seconds)
VITE_PING_INTERVAL_MS=45000
